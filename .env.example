PORT=3000
NODE_ENV=development

# Database configuration
DB_HOST=localhost
DB_USER=root
DB_PASSWORD=
DB_NAME=hypervault_db

# Security secrets (generate random strings for your deployment)
JWT_SECRET=your_super_secret_jwt_key_at_least_64_bytes_hex
AES_KEY=your_aes_256_key_32_bytes_hex_string
# Clé HMAC séparée (32 octets en hex)
HMAC_KEY=your_hmac_key_32_bytes_hex_string
